{
  "description": "Permission slips: issue slips from your prompts, check them before guarded tool calls.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/slips/slip.py\" issue", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/slips/slip.py\" check", "timeout": 10 } ] }
    ]
  }
}
